---
import { Image, getImage } from "astro:assets";

import Image1 from "../assets/images/gallery/auction-gathering-photo.jpg";
import Image2 from "../assets/images/gallery/auction-in-progress-photo.jpg";
import Image3 from "../assets/images/gallery/cadillac-car-photo.jpg";
import Image4 from "../assets/images/gallery/cars-in-auction-2.jpg";
import Image5 from "../assets/images/gallery/cars-in-auction.jpg";
import Image6 from "../assets/images/gallery/dirtbike-photo.jpg";
import Image7 from "../assets/images/gallery/donation-check-photo.jpg";
import Image8 from "../assets/images/gallery/facebook-logo.jpg";
import Image9 from "../assets/images/gallery/members-photo-2.jpg";
import Image10 from "../assets/images/gallery/members-photo.jpg";
import Image11 from "../assets/images/gallery/team-photo.jpg";

const images = [
  Image1, Image2, Image3, Image4, Image5, Image6,
  Image7, Image8, Image9, Image10, Image11
];

// Generate tiny placeholders for blur-up effect at build time
const placeholders = await Promise.all(
  images.map(img => getImage({ src: img, width: 20, format: 'webp', quality: 20 }))
);
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {images.map((img, index) => (
    <div 
      class="relative w-full h-64 rounded-lg overflow-hidden bg-brand-gray/10 shadow-sm hover:shadow-md transition-shadow duration-300"
      style={`background-image: url(${placeholders[index].src}); background-size: cover; background-position: center;`}
    >
      <div class="absolute inset-0 backdrop-blur-md"></div>
      <Image
        src={img}
        alt={`Mid Kansas Auto Auction gallery photo ${index + 1}`}
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 33vw"
        format="avif"
        quality={80}
        loading="lazy"
        decoding="async"
        class="relative z-10 w-full h-full object-cover transition-opacity duration-700"
        onload="this.style.opacity=1"
        style="opacity: 0;"
      />
    </div>
  ))}
</div>
