---
import Image from "astro/components/Image.astro";
import Button from "../Button.astro";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  date: string;
  time: string;
  location: string;
  description: string;
  imagePath: string;
  detailsLink: string;
}

const { title, date, time, location, description, imagePath, detailsLink } = Astro.props;

// Dynamically import images from the events directory
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/events/*.png");
const imageKey = Object.keys(images).find(key => key.endsWith(imagePath));
const imagePromise = imageKey ? images[imageKey]() : null;
---

<div class="flex flex-col md:flex-row items-center md:items-start gap-8 bg-white border border-gray-200 shadow-sm p-6 lg:p-10 transition-shadow hover:shadow-md">
  <!-- Event Image -->
  <div class="w-full md:w-1/3 max-w-[280px] shrink-0">
    {
      imagePromise ? (
        <Image
          src={imagePromise}
          alt={title}
          class="w-full h-auto object-contain"
          width={300}
        />
      ) : (
        <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400">
          Image not found
        </div>
      )
    }
  </div>

  <!-- Event Details -->
  <div class="flex-1 flex flex-col items-start text-left">
    <h4 class="text-sm md:text-base font-bold text-brand-gray mb-1">{title}</h4>
    <h3 class="text-2xl md:text-3xl font-bold text-brand-primary mb-2 leading-tight">
      {date}
    </h3>
    <p class="text-xs md:text-sm text-gray-500 font-medium tracking-wide uppercase mb-4">
      {time} | {location}
    </p>
    <p class="text-sm md:text-base text-gray-600 font-light leading-relaxed mb-6">
      {description}
    </p>

    <Button href={detailsLink} variant="primary" class="px-8 py-2.5 text-sm">
      Event Details
    </Button>
  </div>
</div>
