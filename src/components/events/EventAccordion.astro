---
import { cn } from "../../utils/cn";

export interface Props {
  title: string;
  class?: string;
}

const { title, class: extraClass } = Astro.props;
---

<details
  open
  class={cn(
    "group mt-8 border-t border-b border-gray-200 py-4 cursor-pointer",
    extraClass
  )}
>
  <summary
    class="flex items-center justify-between text-sm md:text-base font-semibold text-brand-gray hover:text-brand-primary transition-colors outline-none list-none"
  >
    <span>{title}</span>
    <span class="transition group-open:rotate-180">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </span>
  </summary>
  <div class="mt-4 text-sm md:text-[15px] leading-relaxed text-gray-600 prose prose-brand max-w-none">
    <slot />
  </div>
</details>

<style>
  /* Hide the default marker for WebKit browsers */
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
