---
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  subtitle?: string;
  bgImage: string | ImageMetadata;
}

const { title, subtitle, bgImage } = Astro.props;
const backgroundImage = typeof bgImage === "string" ? bgImage : bgImage.src;
---

<header
  class="relative w-full py-20 md:py-32 flex flex-col items-center justify-center bg-cover bg-center bg-no-repeat"
  style={`background-image: url('${backgroundImage}');`}
>
  {/* Brand color overlay */}
  <div class="absolute inset-0 bg-brand-primary/85"></div>
  
  {/* Content */}
  <div class="relative z-10 container flex flex-col items-center text-center text-white px-4">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
      {title}
    </h1>
    {subtitle && (
      <p class="text-base md:text-lg max-w-4xl font-light leading-relaxed">
        {subtitle}
      </p>
    )}
  </div>
</header>
