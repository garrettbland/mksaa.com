---
import ShowcaseVideo from "../../assets/videos/experience-video.mp4";
import MapImage from "../../assets/images/mapwhite-2.png";
import Image from "astro/components/Image.astro";
import Button from "../Button.astro";
import SectionHeader from "../SectionHeader.astro";

const features = [
  {
    title: "Fast & Easy",
    desc: "Prime location for hassle-free shipping and receiving vehicles at the intersection of I-35 and 47th St. in South Wichita.",
  },
  {
    title: "Online Bidding",
    desc: "All five lanes are equipped for Internet bidding. Online and mobile bidding currently accounts for 30% of sales.",
  },
  {
    title: "Detailing & Repair",
    desc: "Full service, two-lane detail shop and three-bay mechanical area featured in reconditioning facility. Offering presale and 7-day or 14-day post-sale inspections.",
  },
];

const perksLeft = [
  "Free donuts, fruit, and coffee at every sale",
  "Special events and dealer dinners",
  "Games to compete for cash every week",
];

const perksRight = [
  "12 huge promotional sales each year",
  "Prompt and professional communication",
  "Personal relationships with our team",
];
---

<section class="bg-brand-gray py-20 text-white">
  <div class="container max-w-6xl flex flex-col gap-16">

    <!-- ── Top: Heading + Video ── -->
    <div class="flex flex-col items-center text-center gap-8">
      <SectionHeader
        title="Doing Business at MKSAA"
        subtitle="As our family-owned auction continues to grow, we work with buyers and sellers from all over the country. We specialize in a regional area in the Central U.S. but would welcome your business, regardless of where you are located."
        subtitleClass="max-w-2xl"
      />

      <!-- Video showcase -->
      <div class="w-full max-w-3xl">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="w-full h-auto rounded-xl shadow-2xl bg-black"
          src={ShowcaseVideo}
        >
          Your browser does not support the video tag.
        </video>
      </div>
    </div>

    <!-- ── Middle: Map + Features ── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Map column -->
      <div class="flex flex-col items-start gap-5">
        <Image
          src={MapImage}
          alt="MKSAA Central US Service Area Map"
          class="w-full max-w-sm h-auto object-contain opacity-90"
        />
        <div>
          <p class="font-display italic text-2xl text-white leading-tight">
            Serving the Central U.S.
          </p>
          <div class="w-16 h-0.5 bg-brand-primary my-2"></div>
          <p class="text-xs italic text-white/70 leading-relaxed">
            With Nationwide Attendance<br />
            In-Lane and Online Each Week!<br />
            Our service area will continue to grow!
          </p>
        </div>
      </div>

      <!-- Features + Buttons column -->
      <div class="flex flex-col gap-6">
        {features.map((f) => (
          <div>
            <h4 class="font-display italic text-lg text-white mb-1">{f.title}</h4>
            <p class="text-sm text-white/70 leading-relaxed">{f.desc}</p>
          </div>
        ))}

        <div class="flex flex-col items-start gap-3 mt-2">
          <Button href="https://login.mksaa.com/components/login" external>
            Dealer Login
          </Button>
          <a
            href="/contact"
            class="text-sm text-white/70 hover:text-white underline underline-offset-4 transition-colors"
          >
            How to Register
          </a>
        </div>
      </div>
    </div>

    <!-- ── Bottom: Dealer Perks Card ── -->
    <div class="bg-white rounded-2xl px-10 py-10 text-brand-gray shadow-xl">
      <h3 class="text-2xl md:text-3xl font-bold text-center text-brand-gray mb-8">
        Dealer Perks
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-3">
        <!-- Left perks -->
        <ul class="flex flex-col gap-3">
          {perksLeft.map((perk) => (
            <li class="flex items-center gap-3 text-sm text-gray-700">
              <span class="text-brand-primary text-base shrink-0">★</span>
              {perk}
            </li>
          ))}
        </ul>
        <!-- Right perks -->
        <ul class="flex flex-col gap-3">
          {perksRight.map((perk) => (
            <li class="flex items-center gap-3 text-sm text-gray-700">
              <span class="text-brand-primary text-base shrink-0">★</span>
              {perk}
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</section>
