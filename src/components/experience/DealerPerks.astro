---
import Image from "astro/components/Image.astro";
import MapWhite from "../../assets/images/mapwhite-2.png";
---

<section class="bg-brand-primary py-24 text-white relative overflow-hidden">
  <!-- background graphics -->
  <div class="absolute inset-0 opacity-10 flex justify-center items-center pointer-events-none">
    <Image src={MapWhite} alt="Map Graphic" class="w-96 h-auto max-w-full" />
  </div>
  
  <div class="container max-w-4xl relative z-10">
    <h2 class="text-center text-3xl md:text-4xl font-bold mb-12">Dealer Perks</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Perk item -->
      <div class="flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 hover:bg-white/10 transition duration-300">
        <div class="text-3xl text-red-300">🍩</div>
        <div>
          <h4 class="font-semibold text-lg mb-1">Free Donuts, Fruit & Coffee</h4>
          <p class="font-thin text-sm text-gray-300">Available at every sale starting early Wednesday mornings.</p>
        </div>
      </div>
      
      <div class="flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 hover:bg-white/10 transition duration-300">
        <div class="text-3xl text-red-300">🍽️</div>
        <div>
          <h4 class="font-semibold text-lg mb-1">Special Events & Dealer Dinners</h4>
          <p class="font-thin text-sm text-gray-300">Unique celebrations to thank our dealers and build community.</p>
        </div>
      </div>
      
      <div class="flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 hover:bg-white/10 transition duration-300">
        <div class="text-3xl text-red-300">🎮</div>
        <div>
          <h4 class="font-semibold text-lg mb-1">Weekly Cash Competitions</h4>
          <p class="font-thin text-sm text-gray-300">Lively games for dealers to play and win cash prizes every single week.</p>
        </div>
      </div>
      
      <div class="flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 hover:bg-white/10 transition duration-300">
        <div class="text-3xl text-red-300">📅</div>
        <div>
          <h4 class="font-semibold text-lg mb-1">12 Promotional Sales Annually</h4>
          <p class="font-thin text-sm text-gray-300">Massive theme sales each month with extra food, prizes, and volume.</p>
        </div>
      </div>
      
      <div class="flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 hover:bg-white/10 transition duration-300">
        <div class="text-3xl text-red-300">📞</div>
        <div>
          <h4 class="font-semibold text-lg mb-1">Prompt & Professional Comms</h4>
          <p class="font-thin text-sm text-gray-300">Direct access and quick response times from our dedicated team.</p>
        </div>
      </div>
      
      <div class="flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 hover:bg-white/10 transition duration-300">
        <div class="text-3xl text-red-300">🤝</div>
        <div>
          <h4 class="font-semibold text-lg mb-1">Personal Relationships</h4>
          <p class="font-thin text-sm text-gray-300">At MKSAA, you are part of the family, not just another account number.</p>
        </div>
      </div>
    </div>
  </div>
</section>
