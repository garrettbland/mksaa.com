---
interface Props {
  label: string;
  id: string;
  name?: string;
  type?: "text" | "email" | "tel" | "password" | "number" | "url";
  required?: boolean;
  placeholder?: string;
  /** Extra classes for the wrapping div */
  class?: string;
}

const {
  label,
  id,
  name,
  type = "text",
  required = false,
  placeholder = "",
  class: extraClass = "",
} = Astro.props;
---

<div class={`flex flex-col gap-1 ${extraClass}`}>
  <label for={id} class="text-xs text-white font-bold tracking-wide">
    {label}{required && " *"}
  </label>
  <input
    type={type}
    id={id}
    name={name ?? id}
    required={required}
    placeholder={placeholder}
    class="w-full bg-transparent border-0 border-b border-white rounded-none text-white text-sm font-light py-2 px-0 outline-none caret-white transition-colors duration-200 focus:border-b-[#ff4040] autofill:bg-transparent"
  />
</div>
