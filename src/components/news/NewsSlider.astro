---
export interface Props {
  images: string[];
}

const { images } = Astro.props;
// create unique id for this slider instance
const sliderId = `slider-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="relative w-full overflow-hidden bg-gray-100 group" id={sliderId}>
  <!-- Slider Container -->
  <div 
    class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar scroll-smooth w-full"
    data-slider-container
  >
    {images.map((img, index) => (
      <div class="w-full shrink-0 snap-center relative aspect-video flex items-center justify-center bg-black/5">
        <img 
          src={img} 
          alt={`Gallery image ${index + 1}`} 
          class="max-w-full max-h-[600px] object-contain w-auto h-full"
          loading="lazy"
        />
      </div>
    ))}
  </div>

  <!-- Left Arrow -->
  <button 
    type="button"
    class="absolute left-0 top-0 bottom-0 w-16 bg-white/70 hover:bg-white/90 text-gray-800 flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 focus:outline-none disabled:opacity-0"
    aria-label="Previous image"
    data-slider-prev
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>

  <!-- Right Arrow -->
  <button 
    type="button"
    class="absolute right-0 top-0 bottom-0 w-16 bg-white/70 hover:bg-white/90 text-gray-800 flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 focus:outline-none disabled:opacity-0"
    aria-label="Next image"
    data-slider-next
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // Initialize all sliders on the page
  const initSliders = () => {
    document.querySelectorAll('[id^="slider-"]').forEach(slider => {
      const container = slider.querySelector('[data-slider-container]') as HTMLElement;
      const prevBtn = slider.querySelector('[data-slider-prev]') as HTMLButtonElement;
      const nextBtn = slider.querySelector('[data-slider-next]') as HTMLButtonElement;
      
      if (!container || !prevBtn || !nextBtn) return;
      
      const updateButtons = () => {
        const { scrollLeft, scrollWidth, clientWidth } = container;
        prevBtn.disabled = scrollLeft <= 0;
        nextBtn.disabled = scrollLeft >= scrollWidth - clientWidth - 5; // 5px buffer
        
        if (prevBtn.disabled) prevBtn.classList.add('opacity-50', 'cursor-not-allowed');
        else prevBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        
        if (nextBtn.disabled) nextBtn.classList.add('opacity-50', 'cursor-not-allowed');
        else nextBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      };
      
      container.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);
      
      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth, behavior: 'smooth' });
      });
      
      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth, behavior: 'smooth' });
      });
      
      // Initialize
      setTimeout(updateButtons, 100);
    });
  };

  document.addEventListener('astro:page-load', initSliders);
  initSliders();
</script>
