---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  date: string;
  description: string;
  imagePath: string;
  detailsLink: string;
}

const { title, date, description, imagePath, detailsLink } = Astro.props;

---

<div class="relative flex flex-col md:flex-row items-stretch bg-white transition-all duration-300 hover:opacity-95 group max-w-[980px] mx-auto w-full">
  <!-- Stretched link: makes the whole card clickable/keyboard-focusable without
       nesting the share button (an interactive element) inside an <a>. -->
  <a
    href={detailsLink}
    aria-label={title}
    class="absolute inset-0 z-0"
  ></a>

  <!-- News Image (Left side, exactly 360px width on desktop) -->
  <div class="w-full md:w-[360px] md:min-w-[360px] shrink-0 overflow-hidden relative bg-gray-100 min-h-[234px]">
    <img src={`/images/news/${imagePath}`}
      alt={title}
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
      width="600"
    />
  </div>

  <!-- News Details -->
  <div class="flex-1 flex flex-col text-left py-6 px-6 md:py-8 md:px-[36px]">
    <!-- Date and 3-dots -->
    <div class="flex justify-between items-center mb-4">
      <p class="text-xs text-[#50607c] font-medium tracking-wide">
        {date}
      </p>
      <!-- Share Menu (relative z-10 lifts it above the stretched link so it stays clickable) -->
      <share-menu data-url={detailsLink} data-title={title} class="relative z-10 block">
        <button type="button" class="p-2 -mr-2 text-gray-400 hover:text-brand-primary transition-colors focus:outline-none" aria-label="Share options">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 19 19" aria-hidden="true" class="fill-current">
            <path d="M2.44398805,5.99973295 C1.62345525,5.9690612 0.980075653,5.28418875 1.00047182,4.46312144 C1.02086799,3.64205413 1.69745853,2.98998831 2.51850166,3.0001164 C3.33954478,3.01024449 3.99985313,3.67880182 4,4.50012255 C3.98424812,5.34399206 3.28763905,6.0153508 2.44398805,5.99973295 Z M2.44398805,10.9997329 C1.62345525,10.9690612 0.980075653,10.2841888 1.00047182,9.46312144 C1.02086799,8.64205413 1.69745853,7.98998831 2.51850166,8.0001164 C3.33954478,8.01024449 3.99985313,8.67880182 4,9.50012255 C3.98424812,10.3439921 3.28763905,11.0153508 2.44398805,10.9997329 Z M2.44398805,15.9997329 C1.62345525,15.9690612 0.980075653,15.2841888 1.00047182,14.4631214 C1.02086799,13.6420541 1.69745853,12.9899883 2.51850166,13.0001164 C3.33954478,13.0102445 3.99985313,13.6788018 4,14.5001225 C3.98424812,15.3439921 3.28763905,16.0153508 2.44398805,15.9997329 Z"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="dropdown-menu hidden absolute right-0 top-full mt-1 w-36 bg-white border border-gray-100 shadow-xl z-10 py-1">
          <button type="button" class="share-action w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand-primary transition-colors focus:outline-none">
            Share Post
          </button>
        </div>
      </share-menu>
    </div>

    <!-- Title -->
    <h3 class="text-[24px] font-semibold text-brand-gray mb-3 leading-snug group-hover:text-brand-primary transition-colors line-clamp-2 min-h-12">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-[16px] text-gray-500 font-light leading-relaxed line-clamp-2 min-h-13">
      {description}
    </p>
  </div>
</div>

<script>
  class ShareMenu extends HTMLElement {
    connectedCallback() {
      const toggleBtn = this.querySelector('button[aria-label="Share options"]');
      const dropdown = this.querySelector('.dropdown-menu');
      const shareAction = this.querySelector('.share-action');
      const url = this.dataset.url || '';
      const title = this.dataset.title || '';

      if (!toggleBtn || !dropdown || !shareAction) return;

      // Toggle dropdown
      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        // Close all other dropdowns first
        document.querySelectorAll('share-menu .dropdown-menu').forEach(el => {
          if (el !== dropdown) el.classList.add('hidden');
        });
        
        dropdown.classList.toggle('hidden');
      });

      // Handle share action
      shareAction.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropdown.classList.add('hidden');

        if (navigator.share) {
          try {
            await navigator.share({ title: title, url: url });
          } catch (err) {
            console.error("Error sharing:", err);
          }
        } else {
          // Fallback to clipboard
          navigator.clipboard.writeText(url).then(() => {
            alert("Link copied to clipboard!");
          }).catch(console.error);
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) {
          dropdown.classList.add('hidden');
        }
      });
    }
  }

  // Register only if not already defined
  if (!customElements.get('share-menu')) {
    customElements.define('share-menu', ShareMenu);
  }
</script>
