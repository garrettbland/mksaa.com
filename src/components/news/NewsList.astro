---
import NewsItem from "./NewsItem.astro";
import newsData from "../../data/news.json";

// Sort by date newest first if not already sorted, but it's likely already sorted
// Let's ensure it's sorted just in case
const sortedNews = [...newsData].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<section class="bg-brand-gray py-20">
  <div class="container mx-auto px-4 w-full max-w-[980px]">
    <div class="flex flex-col gap-6">
      {
        sortedNews.map((news) => (
          <NewsItem
            title={news.title}
            date={news.date}
            description={news.description}
            imagePath={news.image || ""}
            detailsLink={`/news/${news.id}`}
          />
        ))
      }
    </div>
  </div>
</section>
