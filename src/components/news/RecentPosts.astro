---
import { getCollection } from "astro:content";

export interface Props {
  currentPostId: string;
}

const { currentPostId } = Astro.props;

const recentPosts = (await getCollection("news"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .filter((post) => post.id !== currentPostId)
  .slice(0, 3);
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
  {recentPosts.map((post) => (
    <a href={`/news/${post.id}`} class="bg-white flex flex-col group hover:shadow-lg transition-shadow">
      <div class="relative w-full h-48 overflow-hidden bg-gray-100">
        {post.data.image && (
          <img
            src={`/images/news/${post.data.image}`}
            alt={post.data.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        )}
      </div>
      <div class="p-6 flex flex-col grow text-left">
        <h3 class="font-bold text-sm text-gray-800 leading-snug line-clamp-2">
          {post.data.title}
        </h3>
      </div>
    </a>
  ))}
</div>
