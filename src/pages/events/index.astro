---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import EventIntro from "../../components/events/EventIntro.astro";
import EventList from "../../components/events/EventList.astro";

// Import the header background image (matching the Wix page)
// Using experience-register-bg.jpg as a placeholder for the red header background
// Alternatively, we can use workers-background.avif
import HeaderBGPhoto from "../../assets/images/events/image.png";
---

<Base
  title="Upcoming Events | Mid Kansas Auto Auction"
  description="Browse upcoming events at Mid Kansas Auto Auction, and see why we are famous for fun!"
>
  <PageHeader title="Upcoming Events" bgImage={HeaderBGPhoto} />

  <EventIntro />

  <EventList />
</Base>
