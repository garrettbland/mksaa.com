---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import HeaderBGPhoto from "../../assets/images/titles-tags.jpg";
---

<Base
  title="Titles, Tags & Reports | Mid Kansas Auto Auction"
  description="We make the paperwork for each unit just as easy as buying and selling. Our titles, tags, and reports service streamlines the documentation process so your transactions are completed quickly and correctly."
>
  <!-- Header -->
  <section class="bg-brand-primary py-36 relative overflow-hidden">
    <div class="text-white container max-w-xl mx-auto relative z-10">
      <h1
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        Titles, Tags & Reports
      </h1>
      <p class="font-thin text-white text-center leading-loose text-sm">
        We make the paperwork for each unit just as easy as buying and
        selling. Our titles, tags, and reports service streamlines the
        documentation process so your transactions are completed quickly and
        correctly, helping you avoid delays and keep your sales moving
        smoothly.
      </p>
    </div>
    <Image
      src={HeaderBGPhoto}
      alt="Vehicle title and paperwork processing"
      class="w-full h-full object-cover absolute top-0 left-0 opacity-20 z-1"
      quality="low"
    />
  </section>

  <!-- Content -->
  <section class="bg-brand-gray py-24">
    <div class="container max-w-xl mx-auto flex flex-col items-center gap-8">
      <a
        href="/uploads/titles-tags-reports.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
      >
        More Details
      </a>
      <a
        href="/services"
        class="text-white underline font-thin text-sm hover:text-gray-200 transition"
      >
        See All Services
      </a>
    </div>
  </section>
</Base>
