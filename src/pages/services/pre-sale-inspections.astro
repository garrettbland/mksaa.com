---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import HeaderBGPhoto from "../../assets/images/pre-sale-inspection.jpg";
---

<Base
  title="Pre-Sale Inspections | Mid Kansas Auto Auction"
  description="Ensure peace of mind before the auction begins. Our pre-sale inspections provide a thorough review of each vehicle's condition so you know exactly what you're buying or selling."
>
  <!-- Header -->
  <section class="bg-brand-primary py-36 relative overflow-hidden">
    <div class="text-white container max-w-xl mx-auto relative z-10">
      <h1
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        Pre-Sale Inspections
      </h1>
      <p class="font-thin text-white text-center leading-loose text-sm">
        Ensure peace of mind before the auction begins. Our pre-sale
        inspections provide a thorough review of each vehicle's condition so
        you know exactly what you're buying or selling. Purchase this
        feature to reassure your buyers that you are selling a sound
        product.
      </p>
    </div>
    <Image
      src={HeaderBGPhoto}
      alt="Mechanic performing a pre-sale vehicle inspection"
      class="w-full h-full object-cover absolute top-0 left-0 opacity-20 z-1"
      quality="low"
    />
  </section>

  <!-- Content -->
  <section class="bg-brand-gray py-24">
    <div class="container max-w-xl mx-auto flex flex-col items-center gap-8">
      <a
        href="/uploads/naa-pre-sale-certification.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
      >
        Pre-Sale Services
      </a>
      <a
        href="/services"
        class="text-white underline font-thin text-sm hover:text-gray-200 transition"
      >
        See All Services
      </a>
    </div>
  </section>
</Base>
