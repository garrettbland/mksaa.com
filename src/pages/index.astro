---
import Base from "../layouts/Base.astro";
import HeaderVideo from "../components/HeaderVideo.astro";
import diamondBackground from "../assets/images/diamond-background.avif";
import GalleryImage1 from "../assets/images/about-gallery-1.avif";
import GalleryImage2 from "../assets/images/about-gallery-2.avif";
import GalleryImage3 from "../assets/images/about-gallery-3.avif";
import GalleryImage4 from "../assets/images/about-gallery-4.avif";
import GalleryImage5 from "../assets/images/about-gallery-5.avif";
import AuctionBackground from "../assets/images/auction-background.avif";
import EdgePipelineLogo from "../assets/images/pipeline-edge-logo.avif";
import WorkersBackground from "../assets/images/workers-background.avif";
import Quote1 from "../assets/images/quote_1.avif";
import Quote2 from "../assets/images/quote_2.avif";
import Quote3 from "../assets/images/quote_3.avif";
---

<Base title="title" description="wee">
  <HeaderVideo />

  <!-- Sale Scedule -->
  <section class="bg-brand-gray relative overflow-hidden flex justify-center">
    <!-- background image -->
    <div class="absolute z-[1] overflow-hidden">
      <img
        src={diamondBackground.src}
        alt="Decorative Background"
        class="w-full h-full object-cover opacity-20"
      />
    </div>

    <!-- content -->
    <div
      class="relative z-[2] my-36 container max-w-3xl flex flex-col items-center justify-center gap-4"
    >
      <h2 class="text-center leading-loose">
        <span class="text-4xl text-red-300 font-semibold">Sales Every</span><br
        />
        <span class="text-4xl font-bold leading-loose text-white"
          >Wednesday</span
        >
      </h2>

      <!-- horizontal line -->
      <div class="h-px bg-white w-full"></div>

      <p class="text-center text-3xl font-semibold text-white">
        Sale Starts at 9:00 AM
      </p>
      <address class="text-center text-red-300 text-brand-primary italic">
        4716 South Santa Fe St, Wichita, KS
      </address>

      <!-- Schedule -->
      <div class="bg-white rounded-lg p-8 text-center text-lg">
        <span class="text-brand-primary font-semibold">Office Hours:</span>
        <ul class="font-thin">
          <li>Mon: 9:00 AM - 5:00 PM</li>
          <li>Tues: 9:00 AM - 5:00 PM</li>
          <li>Wed: 7:00 AM - 5:00 PM</li>
          <li>Thurs: 9:00 AM - 5:00 PM</li>
          <li>Fri: 9:00 AM - 1:00 PM</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- About Us -->
  <section
    class="bg-brand-primary relative overflow-hidden flex justify-center"
  >
    <div
      class="relative z-[2] my-24 container max-w-3xl flex flex-col items-center justify-center gap-4"
    >
      <h2
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        About Us
      </h2>

      <!-- horizontal line -->
      <div class="h-px bg-white w-full"></div>

      <p
        class="text-center text-3xl md:text-4xl lg:text-5xl text-white font-cursive"
      >
        Conveniently Located and Fully Equipped
      </p>

      <p class="font-thin text-white text-lg text-center leading-loose">
        We are a full-service, dealers-only auto auction located in the heart of
        the Midwest. With our central location in the U.S., a modern facility,
        and ample space in our secure lot, we are committed to investing in the
        technology and amenities that provide the very best experience for our
        dealers. We also offer in-house FastBack Title Service, detailing,
        repair services, transportation, online access to weekly sales, and
        more. Vehicles are available for purchase 24/7; with Pipeline, OVE, and
        Smart Auction – we have vehicles for sale every day. Our dealers have
        individual representatives who work with them to make the process easy
        and personalized for your buying and selling needs.
      </p>

      <!-- images -->
      <div class="grid grid-cols-5 w-full h-64 gap-5">
        <div class="translate -skew-x-6 overflow-hidden">
          <img
            src={GalleryImage1.src}
            alt="Logo"
            class="w-full h-full object-cover bg-blue-100"
          />
        </div>
        <div class="translate -skew-x-6 overflow-hidden">
          <img
            src={GalleryImage2.src}
            alt="Logo"
            class="w-full h-full object-cover bg-blue-100"
          />
        </div>
        <div class="translate -skew-x-6 overflow-hidden">
          <img
            src={GalleryImage3.src}
            alt="Logo"
            class="w-full h-full object-cover bg-blue-100"
          />
        </div>
        <div class="translate -skew-x-6 overflow-hidden">
          <img
            src={GalleryImage4.src}
            alt="Logo"
            class="w-full h-full object-cover bg-blue-100"
          />
        </div>
        <div class="translate -skew-x-6 overflow-hidden">
          <img
            src={GalleryImage5.src}
            alt="Logo"
            class="w-full h-full object-cover bg-blue-100"
          />
        </div>
      </div>

      <!-- buttons -->
      <div class="flex flex-row gap-8 mt-8">
        <a
          href="/services"
          class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
        >
          See Our Services
        </a>
        <a
          href="/experience"
          class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
        >
          Sell Here
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section
    class="bg-brand-gray relative overflow-hidden bg-fixed bg-cover bg-center bg-no-repeat"
    style={`background-image: url(${AuctionBackground.src})`}
  >
    <!-- Gray overla -->
    <div class="absolute z-1 w-full h-full bg-brand-gray opacity-80"></div>

    <!-- content -->
    <div class="container max-w-4xl mx-auto py-36 z-2 relative">
      <div
        class="grid grid-cols-2 md:grid-cols-4 divide-x-2 divide-gray-300 text-center"
      >
        <div class="text-center">
          <p class="text-white text-4xl font-bold leading-loose">37</p>
          <p class="text-white text-xl opacity-80">Acres</p>
        </div>
        <div class="text-center">
          <p class="text-white text-4xl font-bold leading-loose">36K</p>
          <p class="text-white text-xl opacity-80">Square Feet</p>
        </div>
        <div class="text-center">
          <p class="text-white text-4xl font-bold leading-loose">5</p>
          <p class="text-white text-xl opacity-80">Auction Lanes</p>
        </div>
        <div class="text-center">
          <p class="text-white text-4xl font-bold leading-loose">158%</p>
          <p class="text-white text-xl opacity-80">Growth Since 2018</p>
        </div>
      </div>
      <div class="mt-12 h-px w-full bg-white"></div>
    </div>
  </section>

  <!-- Upcoming events -->
  <section
    class="bg-brand-primary relative overflow-hidden flex justify-center"
  >
    <div
      class="relative z-[2] my-24 container max-w-3xl flex flex-col items-center justify-center gap-4"
    >
      <h2
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        Upcoming Events
      </h2>

      <!-- horizontal line -->
      <div class="h-px bg-white w-full"></div>

      <p
        class="text-center text-3xl md:text-4xl lg:text-5xl text-white font-cursive"
      >
        Sales Every Week + Big Promo Sales Monthly
      </p>

      <a
        href="/uploads/2025-sales-calendar.pdf"
        class="my-12 rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
      >
        Download a 2025 Promo Sale Calendar
      </a>

      <p class="font-thin text-white text-lg text-center leading-loose">
        Every Wednesday, we host a sale at our auction in Wichita, Kansas. Free
        donuts, fruit, and coffee are served starting as early as 7 AM (CST) and
        the sale begins at 9:00 AM (CST). We always have at least one local food
        truck on-site, unless we've got free food as part of our big promotional
        sales. Be here early for your chance to play a game and win cash, and
        stick around to the end where we have progressive games (shuffleboard,
        football toss, etc.) that give dealers a chance to win cash prizes.
      </p>

      <p class="font-thin text-white text-lg text-center leading-loose">
        Once a month, we go all out on a big promotional sale with a special
        theme and extra food and prizes. Our promotional sales are a time for us
        to appreciate and celebrate our dealers! See more about our upcoming
        promotional sales in the list below, or on the <a
          href="/events"
          class="text-white underline">Events</a
        > page.
      </p>

      <!-- buttons -->
      <div class="flex flex-row gap-8 mt-8">
        <a
          href="/events"
          class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
        >
          See Upcoming Events
        </a>
        <a
          href="https://login.mksaa.com/components/login"
          class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
        >
          Dealer Login
        </a>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="bg-brand-gray relative overflow-hidden flex justify-center">
    <div
      class="relative z-[2] my-24 container max-w-3xl flex flex-col items-center justify-center gap-4"
    >
      <h2
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        Who we serve
      </h2>

      <!-- horizontal line -->
      <div class="h-px bg-white w-full"></div>

      <p
        class="text-center text-3xl md:text-4xl lg:text-5xl text-white font-cursive"
      >
        Serving Dealers Across the Midwest & Beyond
      </p>

      <p class="font-thin text-white text-lg text-center leading-loose">
        We are proudly and conveniently located in Wichita, Kansas, and serve a
        large geographic area across the United States. With the power of the
        web and modern technology, we can serve any dealer from anywhere
        nationwide. Our weekly sales are offered in-person and online, so you
        can purchase from wherever you live with ease. Whether you're a
        franchise, independent dealership, fleet, or corporate client, our
        friendly team is here to serve you. And we work with great
        transportation companies, making it easy to get vehicles purchased at
        MKSAA to your lot. Come experience our modern facility with
        old-fashioned service and values. Join us at Mid Kansas Auto Auction and
        see the difference for yourself!
      </p>
    </div>
  </section>

  <!-- Edge Pipeline -->
  <section
    class="bg-brand-gray relative overflow-hidden bg-fixed bg-cover bg-center bg-no-repeat"
    style={`background-image: url(${WorkersBackground.src})`}
  >
    <!-- Gray overla -->
    <div class="absolute z-1 w-full h-full bg-brand-gray opacity-80"></div>

    <!-- content -->
    <div class="container max-w-4xl mx-auto py-36 z-2 relative">
      <img
        src={EdgePipelineLogo.src}
        alt="Pipeline Edge Logo"
        class="w-48 h-auto mx-auto mb-12"
      />
      <div class="mb-12 h-px w-full bg-white"></div>
      <p
        class="text-center text-3xl md:text-4xl lg:text-5xl text-white font-cursive"
      >
        Serving Dealers Across the Midwest & Beyond
      </p>
      <p class="font-thin text-white text-lg text-center leading-loose">
        Our Dealer Portal gives you a chance to see our upcoming run lists. This
        is also where you can log in to participate virtually and bid online.
        Signing up is free and easy.
      </p>

      <!-- buttons -->
      <div class="flex flex-row gap-8 mt-8 justify-center">
        <a
          href="https://login.mksaa.com/components/login"
          class="rounded-lg text-brand-primary bg-white px-12 py-4 text-lg hover:bg-brand-primary hover:text-white transition font-semibold"
        >
          Dealer Login
        </a>
      </div>

      <div class="flex justify-center mt-6 font-thin">
        <a
          href="https://login.mksaa.com/components/login/signup"
          class="text-white underline hover:opacity-80 transition"
          >How to register</a
        >
      </div>
    </div>
  </section>

  <!-- What people are saying -->
  <section
    class="bg-brand-primary relative overflow-hidden flex justify-center"
  >
    <div
      class="relative z-[2] my-24 container max-w-5xl flex flex-col items-center justify-center gap-4"
    >
      <h2
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        What people are saying
      </h2>

      <!-- horizontal line -->
      <div class="h-px bg-white w-full my-8"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <img src={Quote1.src} alt="Quote 1" />
        <img src={Quote2.src} alt="Quote 2" />
        <img src={Quote3.src} alt="Quote 3" />
      </div>
    </div>
  </section>
</Base>
