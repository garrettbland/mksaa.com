---
import Base from "../layouts/Base.astro";
import HeaderBGPhoto from "../assets/images/contact-bg.jpg";
import PageHeader from "../components/PageHeader.astro";
import Button from "../components/Button.astro";
---

<Base
  title="Contact Us | Mid Kansas Auto Auction"
  description="Get in touch with Mid Kansas Auto Auction. We would love to hear from you."
>
  {/* Header Section */}
  <PageHeader
    title="Contact Us"
    bgImage={HeaderBGPhoto}
  >
    <div class="flex flex-col items-center mt-2 max-w-3xl">
      <h2 class="font-display italic text-3xl md:text-4xl lg:text-5xl text-white mb-6">We Would Love to Hear From You!</h2>
      <p class="text-sm md:text-base text-white/90 font-light leading-relaxed text-center">
        Mid Kansas Auto Auction takes pride in being involved in so many different sectors of the wholesale automotive industry. Whether you're a licensed auto dealer, a service provider, or a financial institution, we'd love to work with you. Please reach out by phone or email so we can tailor a proposal for you!
      </p>
    </div>
  </PageHeader>

  {/* Get in Touch Section */}
  <section class="bg-brand-gray text-white py-16 px-6 lg:px-24 flex flex-col items-center">
    <h3 class="text-3xl md:text-4xl font-bold mb-12">Get in Touch</h3>
    
    <div class="flex flex-col gap-10 w-max mb-12">
      <div class="flex items-center gap-6">
        <svg class="w-12 h-12 text-white shrink-0" preserveAspectRatio="xMidYMid meet" viewBox="13.5 13.5 173 173" fill="currentColor">
          <path d="M88.4 77.9c1.6-1.6 1.4-5.4-.3-7.1L74.7 57.4c-1.6-1.6-4.8-1.3-6.4.3l-3.4 3.4L85 81.3l3.4-3.4z" />
          <path d="M102.1 122.2c-6.1 0-12.6-2.2-17.7-7.3-8.7-8.7-8.5-21.5-3.1-29.4L61.2 65.4C57.7 70.8 57 78.6 59 87.8c2.7 11.6 9.6 23.4 19.4 33.2 9.7 9.7 22 16.9 33.6 19.7 9.3 2.2 17.3 1.6 22.7-1.8l-20.2-20.2c-3.4 2.2-7.8 3.5-12.4 3.5z" />
          <path d="M100 13.5c-47.7 0-86.5 38.8-86.5 86.5s38.8 86.5 86.5 86.5 86.5-38.8 86.5-86.5-38.8-86.5-86.5-86.5zm46.3 122.3l-5.4 5.4c-.2.2-.3.3-.4.3-4.5 4.1-10.9 6.1-18.4 6.1-3.6 0-7.4-.5-11.5-1.5-12.8-3.1-25.7-10.6-36.2-21.2s-17.9-23.3-20.8-36c-2.9-12.4-1-23.1 5.2-29.7.1-.1.2-.2.2-.3l5.4-5.4c2-2 4.8-3.1 7.6-3.1 2.7 0 5.1 1 6.8 2.8L92 66.8c4 4 4.2 11.3.3 15.1l-5 5.1c-5.4 5.4-6.1 16.8 1 23.9 7.4 7.4 19.2 7 24.6 1.7l5-5c2-2 4.8-3.1 7.6-3.1 2.7 0 5.1 1 6.8 2.8l13.4 13.4c4.2 3.9 4.4 11.2.6 15.1z" />
          <path d="M128.5 111.2c-1.6-1.6-4.8-1.3-6.4.3l-3.4 3.4 20.2 20.2 3.4-3.4c1.6-1.6 1.4-5.4-.3-7.1l-13.5-13.4z" />
        </svg>
        <div>
          <p class="text-sm font-light text-white/70">Call Us Today</p>
          <a href="tel:3165007700" class="text-lg font-bold hover:text-brand-primary transition">(316) 500-7700</a>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <svg class="w-12 h-12 text-white shrink-0" preserveAspectRatio="xMidYMid meet" viewBox="10 10 180 180" fill="currentColor">
          <path d="M99.6 58.5c-18 0-32.1 14.2-32.1 32.5 0 19.6 24.8 46.6 32.1 54.3 7.4-7.6 32.1-34.3 32.1-54.3.1-18.2-14.1-32.5-32.1-32.5zm0 37c-6.8 0-12.2-5.5-12.2-12.2 0-6.8 5.5-12.2 12.2-12.2 6.8 0 12.2 5.5 12.2 12.2.1 6.7-5.4 12.2-12.2 12.2z" />
          <path d="M99.6 77.1c-3.4 0-6.3 2.8-6.3 6.3 0 3.4 2.8 6.3 6.3 6.3 3.4 0 6.3-2.8 6.3-6.3s-2.7-6.3-6.3-6.3z" />
          <path d="M100 10c-49.7 0-90 40.3-90 90s40.3 90 90 90 90-40.3 90-90-40.2-90-90-90zm1.7 141.6c-.5.5-1.3.8-2.1.8s-1.4-.3-2.1-.8c-1.4-1.4-36-35.1-36-60.6 0-21.5 16.7-38.3 38.1-38.3s38.1 16.8 38.1 38.3c0 25.8-34.5 59.1-36 60.6z" />
        </svg>
        <div>
          <p class="text-sm font-light text-white/70">Stop by the Office</p>
          <p class="text-lg font-bold">4716 South Santa Fe St.<br/>Wichita, KS 67216</p>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <svg class="w-12 h-12 text-white shrink-0" preserveAspectRatio="xMidYMid meet" viewBox="12 12 176 176" fill="currentColor">
          <path d="M52.7 78.1l48 22.2 46.2-21.2v-8.2H52.7v7.2z" />
          <path d="M99.3 107.1L52.7 85.6v44.3h94.2V86.5L102.1 107c-.8.5-1.9.5-2.8.1z" />
          <path d="M100 12c-48.6 0-88 39.4-88 88s39.4 88 88 88 88-39.4 88-88-39.3-88-88-88zm53.9 121.5c0 1.8-1.5 3.3-3.3 3.3H49.9c-1.8 0-3.3-1.5-3.3-3.3V67.2c0-1.8 1.5-3.3 3.3-3.3h100.6c1.8 0 3.3 1.5 3.3 3.3l.1 66.3z" />
        </svg>
        <div>
          <p class="text-sm font-light text-white/70">Send us an Email</p>
          <a href="mailto:sales@mksaa.com" class="text-lg font-bold hover:text-brand-primary transition">sales@mksaa.com</a>
        </div>
      </div>
    </div>

    <Button 
      href="https://search.google.com/local/writereview?placeid=ChIJO_N3S37Qh4cRIrbTvOn6H_U" 
      external 
      class="mb-16"
    >
      Review Us on Google
    </Button>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-2xl w-full text-center mb-16">
      <div>
        <h4 class="font-bold mb-4">Office Hours:</h4>
        <ul class="text-sm font-light space-y-1 text-white/90">
          <li>Mon: 9:00 AM - 5:00 PM</li>
          <li>Tues: 9:00 AM - 5:00 PM</li>
          <li>Wed: 7:00 AM - 5:00 PM</li>
          <li>Thurs: 9:00 AM - 5:00 PM</li>
          <li>Fri: 9:00 AM - 1:00 PM</li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold mb-4">Gate Hours:</h4>
        <ul class="text-sm font-light space-y-1 text-white/90">
          <li>Mon: 8:00 AM - 5:00 PM</li>
          <li>Tues: 8:00 AM - 7:00 PM</li>
          <li>Wed: 7:00 AM - 6:00 PM</li>
          <li>Thurs: 8:00 AM - 5:00 PM</li>
          <li>Fri: 8:00 AM - 3:00 PM</li>
        </ul>
      </div>
    </div>

    {/* Map */}
    <div class="w-full max-w-4xl h-[400px] rounded-lg overflow-hidden border border-white/10 shadow-lg">
      <iframe src="https://www.google.com/maps?q=4716+S+Santa+Fe+St,+Wichita,+KS+67216,+USA&output=embed" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  {/* Contact Form Section */}
  <section class="bg-[#555555] text-white py-20 px-6 lg:px-24 flex flex-col items-center">
    <h3 class="text-2xl md:text-3xl font-bold mb-12">Contact Us</h3>
    
    <form class="max-w-xl w-full flex flex-col gap-6" action="#" method="POST">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <div class="flex flex-col gap-2">
          <label for="firstName" class="text-sm font-bold">First Name</label>
          <input type="text" id="firstName" name="firstName" class="bg-transparent border border-white rounded px-4 py-2 outline-none transition" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="lastName" class="text-sm font-bold">Last Name</label>
          <input type="text" id="lastName" name="lastName" class="bg-transparent border border-white rounded px-4 py-2 outline-none transition" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <div class="flex flex-col gap-2">
          <label for="email" class="text-sm font-bold">Email *</label>
          <input type="email" id="email" name="email" required class="bg-transparent border border-white rounded px-4 py-2 outline-none transition" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="phone" class="text-sm font-bold">Phone</label>
          <input type="tel" id="phone" name="phone" class="bg-transparent border border-white rounded px-4 py-2 outline-none transition" />
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label for="message" class="text-sm font-bold">Write a message</label>
        <textarea id="message" name="message" rows="5" class="bg-transparent border border-white rounded px-4 py-2 outline-none transition resize-y"></textarea>
      </div>

      <div class="flex justify-center mt-6">
        <Button type="submit">Submit</Button>
      </div>
    </form>
  </section>
</Base>
