---
import Image from "astro/components/Image.astro";
import Base from "../layouts/Base.astro";
import HeaderBGPhoto from "../assets/images/people-talking.avif";
---

<Base
  title="MKSAA Experience | Mid Kansas Auto Auction"
  description="MKSAA is well-equipped to personalize the buying and selling experience to your business's exact needs. Our primary goal is to create a partnership that benefits both parties in the most enjoyable and seamless way possible. Let our team go to work for you!"
>
  <!-- Header -->
  <section class="bg-brand-primary py-36 relative overflow-hidden">
    <div class="text-white container max-w-xl mx-auto relative z-10">
      <h1
        class="text-center leading-tight text-4xl font-bold leading-loose text-white"
      >
        MKSAA Experience
      </h1>
      <p class="font-thin text-white text-center leading-loose text-sm">
        MKSAA is well-equipped to personalize the buying and selling experience
        to your business's exact needs. Our primary goal is to create a
        partnership that benefits both parties in the most enjoyable and
        seamless way possible. Let our team go to work for you!
      </p>
    </div>
    <Image
      src={HeaderBGPhoto}
      alt="Employees at auction"
      class="w-full h-full object-cover absolute top-0 left-0 opacity-20 z-1"
      quality="low"
    />
  </section>
</Base>
